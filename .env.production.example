POSTGRES_USER=babeltower
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=babeltower

DATABASE_URL=postgresql+asyncpg://babeltower:replace-with-a-long-random-password@db:5432/babeltower
REDIS_URL=redis://redis:6379/0
VOYAGE_API_KEY=replace-with-production-voyage-key
GITHUB_OAUTH_CLIENT_ID=replace-with-production-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-production-github-oauth-client-secret
SERVER_BASE_URL=https://babel-tower.com
SENTRY_DSN=
LOG_LEVEL=INFO
ENV=production

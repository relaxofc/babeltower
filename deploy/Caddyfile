# Replace babel-tower.com (both blocks below) with the domain you own.
# Caddy will automatically obtain and renew Let's Encrypt certificates
# for both the apex and the www subdomain.
babel-tower.com {
    # API surface — everything under /v1/ goes to the FastAPI app.
    handle /v1/* {
        reverse_proxy localhost:8000
    }
    # Prometheus scrape endpoint, same backend.
    handle /metrics {
        reverse_proxy localhost:8000
    }
    # Everything else: serve the static landing page. Humans who land here
    # from a launch tweet should see something readable, not a JSON 404.
    handle {
        root * /opt/babeltower/web
        try_files {path} /index.html
        file_server
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# Canonicalize: www → bare domain, 301 permanent. Caddy issues a separate
# cert for www so the redirect itself is served over HTTPS.
www.babel-tower.com {
    redir https://babel-tower.com{uri} permanent
}
